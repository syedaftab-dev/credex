# AI Spend Audit Tool — CredX Environment Variables
# Copy this file to .env.local and fill in the values

# AI Summary (Choose one or both)
# Get a free Google key at: https://aistudio.google.com/
GOOGLE_AI_API_KEY=
ANTHROPIC_API_KEY=

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email Delivery (Nodemailer / Gmail)
# For Gmail: Use an "App Password" from your Google Account settings
EMAIL_USER=
EMAIL_PASS=

# App URL for absolute links (e.g. in emails or OG tags)
NEXT_PUBLIC_APP_URL=http://localhost:3000
